{
  "schema_version": 1,
  "experiment_id": "macnna_global_l20_repeats_v1_split43",
  "description": "Repeated vessel-name-disjoint DeepShip partition for the L20 global-attention study.",
  "classes": [
    "Cargo",
    "Passenger",
    "Tank",
    "Tug"
  ],
  "model": {
    "class": "src.models.ma_cnn_a.MACNNAClassifier",
    "expected_num_parameters": 532166,
    "num_classes": 4,
    "branch_kernel_sizes": [
      8,
      16,
      32
    ],
    "branch_intermediate_channels": 32,
    "branch_output_channels": 64,
    "head_channels": 98
  },
  "features": {
    "sample_rate": 16000,
    "clip_duration_seconds": 3.0,
    "overlap_seconds": 0.0,
    "n_fft": 1024,
    "win_length": 1024,
    "hop_length": 512,
    "n_mels": 64,
    "highpass_freq": null
  },
  "split": {
    "split_seed": 43,
    "target_segments_per_class": {
      "train": 3500,
      "val": 1000,
      "test": 500
    },
    "protocols": [
      "vessel_name_disjoint"
    ],
    "freeze_manifest_before_training": true
  },
  "identity_policy": {
    "vessel_name_group_field": "vessel_key",
    "allowed_match_confidence": [
      "high",
      "medium"
    ],
    "exclude_unresolved_recordings": true,
    "require_content_sha256": true,
    "include_ambiguous_names_conservatively": true,
    "physical_vessel_claim_requires": [
      "MMSI",
      "IMO",
      "publisher_confirmed_id"
    ]
  },
  "training": {
    "model_seeds": [
      42,
      43,
      44
    ],
    "batch_size": 16,
    "epochs": 100,
    "optimizer": "SGD",
    "learning_rate": 0.01,
    "momentum": 0.9,
    "min_learning_rate": 1e-05,
    "warmup_epochs": 10,
    "scheduler": "linear_warmup_then_cosine_annealing",
    "early_stopping_patience": 10,
    "loss": "cross_entropy",
    "data_augmentation": "none"
  }
}
