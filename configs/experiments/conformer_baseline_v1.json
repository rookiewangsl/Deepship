    "weight_decay": 0.01,
    "minimum_learning_rate": 0.000001,
    "warmup_ratio": 0.05,
    "warmup_start_factor": 0.1,
    "scheduler": "optimizer_step_linear_warmup_then_cosine_decay",
    "precision": "bf16",
    "max_grad_norm": 1.0,
    "early_stopping_patience": 5,
    "early_stopping_min_delta": 0.0,
    "log_interval_batches": 100
