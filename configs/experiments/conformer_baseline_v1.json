      10.0,
      20.0,
      30.0
    ],
    "window_rule": "center requested context on each frozen three-second segment anchor",
    "remove_dc": true,
    "normalize_waveform": true,
    "highpass_freq": null,
    "speech_denoising": false
  },
  "model": {
