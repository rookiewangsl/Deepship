{
  "schema_version": 1,
  "experiment_id": "belgian_attention_v1",
  "research_question": "Does adding shared global temporal attention to the original MA-CNN-A improve four-class underwater vessel-noise classification across unseen UTC dates in Belgian waters?",
  "protocol": {
    "folds": 3,
    "fold_seed": 42,
    "group_key": "UTC calendar_date",
    "model_seeds": [42, 43, 44],
    "target_classes": ["Cargo", "Passenger", "Tank", "Tug"],
    "maximum_distance_km": 5.0,
    "test_policy": "official test is sealed; development runs are validation-only"
  },
  "features": {
    "source_sample_rate": 48000,
    "source_duration_rule": "frames == source_sample_rate * 10",
    "accepted_source_channels": [1, 2],
    "source_channel_policy": "fixed_channel_0",
    "sample_rate": 16000,
    "clip_duration_seconds": 10.0,
    "n_fft": 1024,
    "win_length": 1024,
    "hop_length": 512,
    "n_mels": 64
  },
  "variants": {
    "g0": {
      "description": "Original MA-CNN-A baseline",
      "expected_num_parameters": 532166
    },
    "g1": {
      "description": "MA-CNN-A with one shared temporal axial attention block before global pooling",
      "expected_num_parameters": 694057
    }
  },
  "shared_adapter": {
    "d_model": 128,
    "num_heads": 4,
    "ffn_expansion": 2,
    "position_kernel_size": 9,
    "temporal_kernel_size": 15,
    "dropout": 0.1,
    "gate_init": -2.0
  },
  "training": {
    "sampling": "class_date_balanced_dynamic",
    "batch_size": 16,
    "eval_batch_size": 16,
    "gradient_accumulation_steps": 2,
    "epochs": 50,
    "optimizer": "adamw",
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "min_learning_rate": 0.000001,
    "warmup_epochs": 5,
    "early_stopping_patience": 8,
    "early_stopping_min_delta": 0.005,
    "precision": "bf16",
    "num_workers": 8,
    "selection_metric": "validation date-balanced macro-F1"
  },
  "decision_rule": {
    "minimum_mean_g1_minus_g0_date_macro_f1": 0.01,
    "bootstrap_confidence_interval_lower_bound_must_exceed_zero": true,
    "minimum_positive_fold_means": 2,
    "maximum_systematic_rare_class_drop": 0.03,
    "bootstrap_resamples": 50000,
    "bootstrap_seed": 42
  }
}
