{
  "schema_version": 1,
  "experiment_id": "belgian_training_sanity_v1",
  "research_question": "Can the original G0 CNN learn the Belgian four-class task after removing the severe per-epoch underexposure confound?",
  "protocol": {
    "fold": 1,
    "model_seed": 42,
    "target_classes": ["Cargo", "Passenger", "Tank", "Tug"],
    "group_key": "UTC calendar_date",
    "test_policy": "official test remains sealed; this diagnostic is validation-only",
    "progression_gate": "G1 is not run unless G0 passes the learning-health gate"
  },
  "features": {
    "source_sample_rate": 48000,
    "source_duration_rule": "frames == source_sample_rate * 10",
    "accepted_source_channels": [1, 2],
    "source_channel_policy": "fixed_channel_0",
    "sample_rate": 16000,
    "clip_duration_seconds": 10.0,
    "n_fft": 1024,
    "win_length": 1024,
    "hop_length": 512,
    "n_mels": 64
  },
  "variants": {
    "g0": {
      "description": "Original MA-CNN-A baseline",
      "expected_num_parameters": 532166
    },
    "g1": {
      "description": "Reserved matched comparison; forbidden before G0 passes the gate",
      "expected_num_parameters": 694057
    }
  },
  "shared_adapter": {
    "d_model": 128,
    "num_heads": 4,
    "ffn_expansion": 2,
    "position_kernel_size": 9,
    "temporal_kernel_size": 15,
    "dropout": 0.1,
    "gate_init": -2.0
  },
  "training": {
    "sampling": "full_epoch_shuffle",
    "loss": "effective_number",
    "effective_number_beta": 0.999,
    "normalization": "train_fold_global_scalar",
    "batch_size": 16,
    "eval_batch_size": 16,
    "gradient_accumulation_steps": 2,
    "epochs": 30,
    "optimizer": "adamw",
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "min_learning_rate": 0.000001,
    "warmup_epochs": 1,
    "early_stopping_patience": 8,
    "early_stopping_min_delta": 0.002,
    "early_stopping_start_epoch": 5,
    "precision": "bf16",
    "num_workers": 8,
    "selection_metric": "validation date-balanced macro-F1"
  },
  "overfit_gate": {
    "samples_per_class": 32,
    "maximum_optimizer_steps": 1000,
    "minimum_train_accuracy": 0.98,
    "minimum_train_macro_f1": 0.98,
    "maximum_train_loss": 0.1
  },
  "g0_learning_health_gate": {
    "minimum_final_train_accuracy": 0.7,
    "minimum_final_train_macro_f1": 0.6,
    "minimum_passenger_train_f1": 0.4,
    "minimum_tug_train_f1": 0.4
  }
}
