{
  "schema_version": 1,
  "experiment_id": "belgian_training_health_v2",
  "research_question": "Can G0 learn all four Belgian classes when every physical batch is strictly balanced while majority-class diversity rotates across epochs?",
  "protocol": {
    "fold": 1,
    "model_seed": 42,
    "target_classes": ["Cargo", "Passenger", "Tank", "Tug"],
    "group_key": "UTC calendar_date",
    "test_policy": "official test remains sealed; this diagnostic is validation-only",
    "progression_gate": "No G1 run unless G0 passes every learning-health condition"
  },
  "features": {
    "source_sample_rate": 48000,
    "source_duration_rule": "frames == source_sample_rate * 10",
    "accepted_source_channels": [1, 2],
    "source_channel_policy": "fixed_channel_0",
    "sample_rate": 16000,
    "clip_duration_seconds": 10.0,
    "n_fft": 1024,
    "win_length": 1024,
    "hop_length": 512,
    "n_mels": 64
  },
  "variants": {
    "g0": {
      "description": "Original MA-CNN-A baseline",
      "expected_num_parameters": 532166
    },
    "g1": {
      "description": "Reserved matched comparison; forbidden before the G0 health gate",
      "expected_num_parameters": 694057
    }
  },
  "shared_adapter": {
    "d_model": 128,
    "num_heads": 4,
    "ffn_expansion": 2,
    "position_kernel_size": 9,
    "temporal_kernel_size": 15,
    "dropout": 0.1,
    "gate_init": -2.0
  },
  "training": {
    "sampling": "strict_class_balanced_batch",
    "samples_per_class_per_epoch": 1024,
    "loss": "cross_entropy",
    "normalization": "train_fold_global_scalar",
    "specaugment": {
      "frequency_mask_param": 8,
      "time_mask_param": 24,
      "frequency_masks": 1,
      "time_masks": 1
    },
    "batch_size": 16,
    "eval_batch_size": 16,
    "gradient_accumulation_steps": 2,
    "epochs": 20,
    "optimizer": "adamw",
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "min_learning_rate": 0.000001,
    "warmup_epochs": 1,
    "early_stopping_patience": 6,
    "early_stopping_min_delta": 0.002,
    "early_stopping_start_epoch": 3,
    "precision": "bf16",
    "num_workers": 8,
    "selection_metric": "validation date-balanced macro-F1"
  },
  "g0_learning_health_gate": {
    "minimum_final_train_accuracy": 0.7,
    "minimum_final_train_macro_f1": 0.6,
    "minimum_passenger_train_f1": 0.4,
    "minimum_tug_train_f1": 0.4,
    "minimum_best_validation_date_macro_f1": 0.20680885769574767
  }
}
